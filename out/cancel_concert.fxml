<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.CancelConcertController">
   <children>
      <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #ff007f; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.4), 20, 0.4, 0, 0);">
         <children>
            <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 0 0 10 0;">
               <children>
                  <Label text="Ακύρωση Συναυλίας 🗑️" textFill="#ff007f">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.7), 10, 0.4, 0, 0);
                     </style>
                  </Label>
                  <Label text="Ακύρωση συναυλίας &amp; αυτόματη επιστροφή χρημάτων" textFill="#00f3ff">
                     <font>
                        <Font name="System Italic" size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <VBox spacing="15.0">
               <children>
                  <Label text="Εισάγετε το ID της Συναυλίας που επιθυμείτε να ακυρώσετε:" textFill="white">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <TextField fx:id="concertIdInput" prefHeight="38.0" promptText="Concert ID" style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-background-radius: 5;" />
               </children>
            </VBox>
            
            <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCancelConcert" prefHeight="42.0" style="-fx-background-color: #ff007f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="ΑΚΥΡΩΣΗ ΣΥΝΑΥΛΙΑΣ &amp; ΕΠΙΣΤΡΟΦΗ ΧΡΗΜΑΤΩΝ 💸">
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.6), 10, 0.4, 0, 0);
                     </style>
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goBack" prefHeight="42.0" style="-fx-background-color: transparent; -fx-text-fill: #00f3ff; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-background-radius: 5; -fx-font-weight: bold;" text="ΕΠΙΣΤΡΟΦΗ ⬅️">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
