<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.CardDetailsScreenController">
    <children>
        <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #3498db; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(52,152,219,0.4), 20, 0.4, 0, 0);">
            <children>
                <Label text="Επιστροφή Χρημάτων" textFill="#3498db">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Εισάγετε τα στοιχεία κάρτας για την επιστροφή:" textFill="white" />
                <TextField fx:id="cardDataField" promptText="Αριθμός Κάρτας (Βάλε 'FAIL' για error)" style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-border-color: #3498db;" />
                <Button mnemonicParsing="false" onAction="#submitCardDetails" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Ολοκλήρωση Ακύρωσης" />
                <Button mnemonicParsing="false" onAction="#cancelRefund" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;" text="Ακύρωση Διαδικασίας" />
            </children>
        </VBox>
    </children>
</VBox>
