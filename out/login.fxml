<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="380.0" spacing="20.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #00f3ff; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.4), 20, 0.4, 0, 0);">
         <padding>
            <Insets bottom="40.0" left="35.0" right="35.0" top="40.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="MusicTick ⚡" textFill="#ff007f">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.8), 12, 0.5, 0, 0);
                     </style>
                  </Label>
                  <Label text="Neon Rhythm Booking Hub" textFill="#00f3ff">
                     <font>
                        <Font name="System Italic" size="13.0" />
                     </font>
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.6), 8, 0.4, 0, 0);
                     </style>
                  </Label>
               </children>
            </VBox>
            <VBox spacing="15.0">
               <children>
                  <TextField fx:id="emailField" prefHeight="40.0" promptText="Email" style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5;" />
                  <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Password" style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5;" />
               </children>
            </VBox>
            <Label fx:id="errorLabel" textFill="#ff4757" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <VBox spacing="12.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" style="-fx-background-color: #00f3ff; -fx-text-fill: #0b0f19; -fx-font-weight: bold; -fx-background-radius: 5;" text="ΣΥΝΔΕΣΗ ⚡">
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.6), 10, 0.4, 0, 0);
                     </style>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToSignUp" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #ff007f; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-background-radius: 5; -fx-font-weight: bold;" text="ΕΓΓΡΑΦΗ 🎫">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
