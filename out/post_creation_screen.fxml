<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="18.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.PostCreationController">
    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
    <children>
        <VBox alignment="CENTER" maxWidth="620.0" spacing="18.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #9b59b6; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 30;">
            <children>
                <Label text="✍️ Νέα Ανάρτηση" textFill="#9b59b6">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label text="Τίτλος:" textFill="#00f3ff" />
                <TextField fx:id="titleField" promptText="Εισάγετε τίτλο ανάρτησης"
                           style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-border-color: #9b59b6; -fx-border-radius: 5; -fx-background-radius: 5;" />
                <Label text="Κείμενο:" textFill="#00f3ff" />
                <TextArea fx:id="contentArea" prefHeight="130.0" wrapText="true" promptText="Γράψτε το κείμενό σας εδώ..."
                          style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-border-color: #9b59b6; -fx-border-radius: 5; -fx-background-radius: 5;" />
                <Label fx:id="messageLabel" textFill="#e74c3c" wrapText="true" />
                <Button mnemonicParsing="false" onAction="#handleSubmitPost" prefHeight="40.0" prefWidth="250.0"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Δημοσίευση Ανάρτησης">
                    <font><Font size="13.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goBack" prefHeight="38.0" prefWidth="250.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #ff007f; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-font-weight: bold;" text="⬅️ ΠΙΣΩ" />
            </children>
        </VBox>
    </children>
</VBox>
