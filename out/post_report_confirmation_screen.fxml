<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.ForumController">
    <children>
        <VBox alignment="CENTER" maxWidth="480.0" spacing="20.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #f39c12; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(243,156,18,0.4), 20, 0.4, 0, 0);">
            <children>
                <Label text="🚩" textFill="#f39c12"><font><Font size="52.0" /></font></Label>
                <Label text="Η αναφορά σας υποβλήθηκε!" textFill="#f39c12">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Label text="Ο διαχειριστής έλαβε ειδοποίηση και θα εξετάσει το post." textFill="white" wrapText="true" />
                <Button mnemonicParsing="false" onAction="#goBack" prefHeight="40.0" prefWidth="220.0"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Επιστροφή στο Forum">
                    <font><Font size="13.0" /></font>
                </Button>
            </children>
        </VBox>
    </children>
</VBox>
