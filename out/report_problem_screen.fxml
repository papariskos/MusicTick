<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.ReportProblemController">
    <children>
        <VBox alignment="CENTER" maxWidth="550.0" spacing="20.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #ff007f; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.4), 20, 0.4, 0, 0);">
            <children>
                <Label text="Αναφορά Προβλήματος ⚠️" textFill="#ff007f">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.6), 10, 0.4, 0, 0);
                    </style>
                </Label>
                
                <Label text="Παρακαλώ εισάγετε τα στοιχεία για τον έλεγχο κρατήσεων" textFill="#00f3ff">
                    <font>
                        <Font name="System Italic" size="13.0" />
                    </font>
                </Label>

                <VBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Label text="Κωδικός Εισιτηρίου (Ticket ID):" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="ticketIdField" promptText="π.χ. 492 (ή FAIL για δοκιμή αποτυχίας)" style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
                    </children>
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Περιγραφή Προβλήματος / Λόγος:" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="reasonArea" prefHeight="120.0" promptText="Γράψτε εδώ το πρόβλημα που αντιμετωπίσατε με το εισιτήριο σας..." style="-fx-control-inner-background: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5;" wrapText="true" />
                    </children>
                </VBox>

                <Label fx:id="statusLabel" textFill="#ff007f" wrapText="true">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#goBack" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: #ff007f; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-background-radius: 5; -fx-font-weight: bold;" text="⬅️ ΕΠΙΣΤΡΟΦΗ">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleSubmitReport" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #00f3ff; -fx-text-fill: #0b0f19; -fx-font-weight: bold; -fx-background-radius: 5;" text="ΥΠΟΒΟΛΗ ΑΝΑΦΟΡΑΣ ⚠️">
                            <style>
                                -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.6), 10, 0.4, 0, 0);
                            </style>
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
