<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musictick.ReviewDisplayController">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
    <Label text="Reviews Συναυλίας" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <TextField fx:id="concertIdField" promptText="Concert ID" prefWidth="420"/>
    <Button text="Εμφάνιση Reviews" onAction="#showReviews"/>
    <Label fx:id="averageRatingLabel" text="Μέση βαθμολογία: -"/>
    <ListView fx:id="reviewListView" prefWidth="520" prefHeight="240"/>
    <Button text="Γράψε Review" onAction="#openSubmitReview"/>
    <Label fx:id="messageLabel" textFill="red"/>
    <Button text="Πίσω" onAction="#goBack"/>
</VBox>
