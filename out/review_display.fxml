<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.ReviewDisplayController">
   <children>
      <VBox alignment="CENTER" maxWidth="600.0" spacing="15.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #00f3ff; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.4), 20, 0.4, 0, 0);">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="5.0" style="-fx-padding: 0 0 5 0;">
               <children>
                  <Label text="Αξιολογήσεις Συναυλίας ⭐" textFill="#ff007f">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.7), 10, 0.4, 0, 0);
                     </style>
                  </Label>
                  <Label text="Δείτε τι είπαν άλλοι θεατές για τη συναυλία" textFill="#00f3ff">
                     <font>
                        <Font name="System Italic" size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <HBox spacing="10.0" alignment="CENTER">
               <children>
                  <TextField fx:id="concertIdField" prefHeight="38.0" prefWidth="300.0" promptText="Εισάγετε Concert ID..." style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5;" />
                  <Button mnemonicParsing="false" onAction="#showReviews" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #00f3ff; -fx-text-fill: #0b0f19; -fx-font-weight: bold; -fx-background-radius: 5;" text="Αναζήτηση ⭐">
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.5), 8, 0.4, 0, 0);
                     </style>
                  </Button>
               </children>
            </HBox>
            
            <VBox alignment="CENTER" style="-fx-background-color: #0b0f19; -fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #ff007f; -fx-border-width: 1; -fx-border-radius: 5;">
               <children>
                  <Label fx:id="averageRatingLabel" text="Μέση βαθμολογία: -" textFill="#ff007f">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <ListView fx:id="reviewListView" prefHeight="180.0" prefWidth="540.0" style="-fx-background-color: #0b0f19; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: white;" />
            
            <Label fx:id="messageLabel" textFill="#ff4757" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            
            <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button mnemonicParsing="false" onAction="#goBack" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #ff007f; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-background-radius: 5; -fx-font-weight: bold;" text="⬅️ ΕΠΙΣΤΡΟΦΗ">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#openSubmitReview" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="ΓΡΑΨΕ REVIEW ✨">
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(46,204,113,0.5), 8, 0.4, 0, 0);
                     </style>
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
