<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.BookingFailureController">
   <children>
      <VBox alignment="CENTER" maxWidth="450.0" spacing="25.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #ff007f; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.4), 20, 0.4, 0, 0);">
         <children>
            <Label text="⚠️" textFill="#ff4757">
               <font>
                  <Font size="64.0" />
               </font>
               <style>
                  -fx-effect: dropshadow(three-pass-box, rgba(255,71,87,0.8), 15, 0.5, 0, 0);
               </style>
            </Label>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="Αποτυχία Διαδικασίας" textFill="#ff007f">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.7), 10, 0.4, 0, 0);
                     </style>
                  </Label>
                  <Label fx:id="errorLabel" alignment="CENTER" maxWidth="350.0" text="Λεπτομέρειες σφάλματος..." textAlignment="CENTER" textFill="#7f8c8d" wrapText="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goBack" prefHeight="40.0" style="-fx-background-color: #00f3ff; -fx-text-fill: #0b0f19; -fx-font-weight: bold; -fx-background-radius: 5;" text="⬅️ ΕΠΙΣΤΡΟΦΗ">
               <style>
                  -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.6), 10, 0.4, 0, 0);
               </style>
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</VBox>
