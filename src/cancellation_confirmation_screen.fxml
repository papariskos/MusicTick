<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.CancellationConfirmationController">
    <children>
        <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #2ecc71; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(46,204,113,0.4), 20, 0.4, 0, 0);">
            <children>
                <Label text="Η Ακύρωση Ολοκληρώθηκε! ✅" textFill="#2ecc71">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Η θέση αποδεσμεύτηκε και τα χρήματα έχουν επιστραφεί στην κάρτα σας." textAlignment="CENTER" textFill="white" wrapText="true" />
                <Button mnemonicParsing="false" onAction="#goHome" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Επιστροφή στην Αρχική" />
            </children>
        </VBox>
    </children>
</VBox>
