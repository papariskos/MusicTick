<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="18.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.PostManagementController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
    <children>
        <VBox alignment="CENTER" maxWidth="760.0" spacing="18.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #e74c3c; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(231,76,60,0.4), 20, 0.4, 0, 0);">
            <children>
                <Label text="🛡️ Διαχείριση Forum (Admin)" textFill="#e74c3c">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <Label text="Επιλέξτε post και Διαγράψτε ή Κλειδώστε το νήμα." textFill="#00f3ff" />

                <ListView fx:id="postsListView" prefHeight="280.0" prefWidth="720.0"
                          style="-fx-background-color: #0b0f19; -fx-border-color: #e74c3c; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <Label fx:id="statusLabel" textFill="#2ecc71" wrapText="true">
                    <font><Font size="13.0" /></font>
                </Label>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleDeletePost" prefHeight="40.0" prefWidth="210.0"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="🗑️ Διαγραφή Post">
                            <font><Font size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleLockThread" prefHeight="40.0" prefWidth="210.0"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="🔒 Κλείδωμα Νήματος">
                            <font><Font size="13.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <Button mnemonicParsing="false" onAction="#goBack" prefHeight="38.0" prefWidth="200.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #ff007f; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-font-weight: bold;" text="⬅️ ΕΠΙΣΤΡΟΦΗ" />
            </children>
        </VBox>
    </children>
</VBox>
