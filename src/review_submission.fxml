<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musictick.ReviewSubmissionController">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
    <Label text="Υποβολή Review" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <TextField fx:id="concertIdField" promptText="Concert ID" prefWidth="420"/>
    <ComboBox fx:id="ratingComboBox" promptText="Βαθμολογία 1-5" prefWidth="420"/>
    <TextArea fx:id="commentArea" promptText="Σχόλιο" prefWidth="420" prefHeight="140" wrapText="true"/>
    <Button text="Υποβολή" onAction="#submitReview"/>
    <Label fx:id="messageLabel" textFill="red"/>
    <Button text="Πίσω" onAction="#goBack"/>
</VBox>
