<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: #0b0f19;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://scene.com/fxml/1" fx:controller="com.musictick.controller.SearchController">
   <children>
      <VBox alignment="CENTER" maxWidth="520.0" spacing="25.0" style="-fx-background-color: #151d30; -fx-background-radius: 15; -fx-border-color: #00f3ff; -fx-border-width: 1.5; -fx-border-radius: 15; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.4), 20, 0.4, 0, 0);">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Αναζήτηση Συναυλιών 🔎" textFill="#ff007f">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(255,0,127,0.7), 10, 0.4, 0, 0);
                     </style>
                  </Label>
                  <Label text="Βρείτε τις αγαπημένες σας μουσικές εκδηλώσεις" textFill="#00f3ff">
                     <font>
                        <Font name="System Italic" size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <TextField fx:id="searchField" prefHeight="40.0" prefWidth="290.0" promptText="Εισάγετε όνομα καλλιτέχνη, τίτλο..." style="-fx-background-color: #0b0f19; -fx-text-fill: white; -fx-prompt-text-fill: #5c6b84; -fx-border-color: #00f3ff; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" />
                  <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #00f3ff; -fx-text-fill: #0b0f19; -fx-font-weight: bold; -fx-background-radius: 5;" text="Αναζήτηση 🔎">
                     <style>
                        -fx-effect: dropshadow(three-pass-box, rgba(0,243,255,0.6), 10, 0.4, 0, 0);
                     </style>
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <Label fx:id="messageLabel" textFill="#ff4757" wrapText="true">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#goBack" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: transparent; -fx-text-fill: #ff007f; -fx-border-color: #ff007f; -fx-border-radius: 5; -fx-border-width: 1.5; -fx-background-radius: 5; -fx-font-weight: bold;" text="⬅️ ΕΠΙΣΤΡΟΦΗ">
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</VBox>
